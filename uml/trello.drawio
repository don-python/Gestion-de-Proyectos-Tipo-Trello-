        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class Proyecto {\n    +int id\n    +String nombre\n    +String descripcion\n    +Date fechaCreacion\n    +consultarAvance()\n  }\n\n  class Tablero {\n    +int id\n    +String nombre\n    +crearLista()\n    +consultarAvance()\n  }\n\n  class Lista {\n    +int id\n    +String nombre\n    +int posicion\n    +agregarTarjeta()\n    +moverTarjeta()\n  }\n\n  class Tarjeta {\n    +int id\n    +String titulo\n    +String descripcion\n    +Date fechaLimite\n    +Estado estado\n    +crear()\n    +mover()\n    +asignarResponsable()\n    +agregarEtiqueta()\n    +agregarComentario()\n  }\n\n  class Usuario {\n    +int id\n    +String nombre\n    +String email\n    +participarEnProyecto()\n    +asignarTarjeta()\n  }\n\n  class Etiqueta {\n    +int id\n    +String nombre\n    +String color\n  }\n\n  class Comentario {\n    +int id\n    +String contenido\n    +Date fechaCreacion\n  }\n\n  class Estado {\n    &lt;&lt;enumeration&gt;&gt;\n    PENDIENTE\n    EN_PROGRESO\n    COMPLETADA\n    BLOQUEADA\n  }\n\n  Proyecto \&quot;1\&quot; *-- \&quot;0..1\&quot; Tablero : tiene\n  Tablero \&quot;1\&quot; *-- \&quot;1..*\&quot; Lista : contiene\n  Lista \&quot;1\&quot; *-- \&quot;0..*\&quot; Tarjeta : organiza\n  Proyecto \&quot;0..*\&quot; -- \&quot;0..*\&quot; Usuario : participantes\n  Usuario \&quot;1\&quot; -- \&quot;0..*\&quot; Tarjeta : responsable\n  Tarjeta \&quot;0..*\&quot; -- \&quot;0..*\&quot; Etiqueta : incluye\n  Tarjeta \&quot;1\&quot; *-- \&quot;0..*\&quot; Comentario : contiene\n  Tarjeta --&gt; Estado : tiene estado\n  Proyecto ..&gt; Tarjeta : consulta avance&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="N8Ujo8RqVnO8v-dOjiEs-80">
